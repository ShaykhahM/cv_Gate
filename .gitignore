# ==============================================================================
# Git Ignore for CVGate (Flutter / Dart / Android / iOS / macOS / Web)
# ==============================================================================

# Environment & Sensitive Files
.env
.env.*
*.env
!.env.example
*.local

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
**/doc/api/

# Android build outputs & caches
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/
**/android/app/build/
*.keystore
*.jks
.gradle/

# iOS / macOS build outputs & caches
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/Generated.xcconfig
**/macos/Flutter/flutter_export_environment.sh

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Logs and temporary files
*.log
*.class
*.pyc
*.swp
*.bak
*~
