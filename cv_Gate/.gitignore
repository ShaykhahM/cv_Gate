# ==============================================================================
# Git Ignore for CVGate (Flutter / Dart / Android / iOS / macOS / Web)
# ==============================================================================

# Environment & Sensitive Files
.env
.env.*
*.env
!.env.example
*.local

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.bak
*~
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ / Android Studio related
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts and temp files
/android/app/debug
/android/app/profile
/android/app/release
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/captures/
**/android/app/build/
*.keystore
*.jks
.gradle/

# iOS / macOS build artifacts and temp files
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/Generated.xcconfig
**/macos/Flutter/flutter_export_environment.sh

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
lib/firebase_options.dart
